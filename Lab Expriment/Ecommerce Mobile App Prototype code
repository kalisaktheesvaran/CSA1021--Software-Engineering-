<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>NOVA — Premium Ecommerce</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,Arial,sans-serif;background:#e9e6e0;color:#151515;display:flex;justify-content:center;min-height:100vh}
.app{width:390px;min-height:100vh;background:#f7f5f1;position:relative;overflow:hidden;box-shadow:0 0 35px #0002}
.screen{display:none;min-height:100vh;padding-bottom:90px}
.screen.active{display:block}
.top{padding:28px 24px 0}
.logo{font-size:24px;font-weight:800}
h1{font-size:28px;line-height:1.12;margin-top:18px}
h2{font-size:20px;margin-bottom:16px}
.muted{color:#77736d;font-size:13px}
.hero{margin:30px 24px 0;background:#151515;color:white;border-radius:24px;padding:22px 18px;height:142px;position:relative;overflow:hidden}
.hero strong{display:block;font-size:29px;margin:8px 0 15px}
.hero:after{content:"N";position:absolute;right:20px;top:18px;font-size:100px;font-weight:900;color:#ff5a4f}
button{border:0;cursor:pointer;font-weight:700}
.pill{background:#ff5a4f;color:white;border-radius:22px;padding:12px 18px}
.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:0 24px}
.cat{text-align:center;font-size:11px;font-weight:700}
.cat div{height:70px;border-radius:18px;background:#ffe7e4;margin-bottom:8px}
.section{padding:30px 24px 0}
.products{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.product{background:white;border-radius:20px;overflow:hidden;padding-bottom:14px}
.pic{height:145px;background:#e6e1d8;display:flex;align-items:center;justify-content:center;font-weight:900;color:white;font-size:25px}
.product:nth-child(2) .pic{background:#dce5e0}
.product:nth-child(3) .pic{background:#e1e3ea}
.product h3,.product p{padding:0 14px}
.product h3{font-size:14px;margin-top:12px}
.product p{font-weight:800;margin-top:7px}
.search{margin:26px 24px 18px;background:white;border-radius:16px;padding:16px;color:#77736d}
.filters{display:flex;gap:8px;padding:0 24px 20px;overflow:auto}
.filters button{white-space:nowrap;border-radius:20px;padding:10px 17px;background:white}
.filters .selected{background:#151515;color:white}
.detail-image{margin:24px;height:350px;border-radius:26px;background:#e6e1d8;display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:900;color:white}
.detail-info{padding:0 24px}
.detail-info h1{margin-top:0}
.sizes{display:flex;gap:10px;margin:12px 0 24px}
.size{background:white;padding:13px 18px;border-radius:12px}
.size.selected{background:#151515;color:white}
.full{width:calc(100% - 48px);margin:0 24px}
.cart-item{margin:18px 24px;background:white;border-radius:18px;padding:16px;display:flex;gap:15px;align-items:center}
.thumb{width:82px;height:82px;border-radius:14px;background:#e6e1d8}
.summary{margin:25px 24px;background:white;border-radius:18px;padding:20px}
.row{display:flex;justify-content:space-between;margin:12px 0;font-size:14px}
.total{font-size:20px;font-weight:800;border-top:1px solid #e8e4de;padding-top:15px}
.form-card{margin:18px 24px;background:white;border-radius:16px;padding:18px}
.success{text-align:center;padding:150px 24px 0}
.check{width:65px;height:65px;border-radius:50%;background:#2e8b67;color:white;font-size:32px;display:grid;place-items:center;margin:auto}
.nav{position:fixed;bottom:0;width:390px;height:70px;background:white;display:flex;justify-content:space-around;align-items:center;border-top:1px solid #eee;z-index:10}
.nav button{background:none;color:#77736d;font-size:12px}
.nav button.active{color:#ff5a4f}
.toast{position:fixed;bottom:85px;left:50%;transform:translateX(-50%);background:#151515;color:white;padding:12px 20px;border-radius:22px;display:none;font-size:13px;z-index:20}
</style>
</head>
<body>
<div class="app">

<section id="home" class="screen active">
<div class="top"><div class="logo">NOVA</div><h1>Your everyday,<br>elevated.</h1><p class="muted">Curated essentials. Better choices.</p></div>
<div class="hero"><span class="muted">THE WEEKEND EDIT</span><strong>Up to 40% off</strong><button class="pill" onclick="show('explore')">SHOP NOW</button></div>
<div class="section"><h2>Popular categories</h2></div>
<div class="categories">
<div class="cat" onclick="show('explore')"><div></div>Fashion</div>
<div class="cat" onclick="show('explore')"><div></div>Beauty</div>
<div class="cat" onclick="show('explore')"><div></div>Tech</div>
<div class="cat" onclick="show('explore')"><div></div>Home</div>
</div>
<div class="section"><h2>Trending now</h2><div class="products">
<div class="product" onclick="show('detail')"><div class="pic">CLOUD</div><h3>Cloud Runner</h3><p>₹2,499</p></div>
<div class="product"><div class="pic">AURA</div><h3>Aura Tote</h3><p>₹1,899</p></div>
</div></div>
</section>

<section id="explore" class="screen">
<div class="top"><div class="logo">Explore</div><p class="muted">Find something you'll love.</p></div>
<div class="search">⌕ &nbsp; Search products</div>
<div class="filters"><button class="selected">All</button><button>New</button><button>Deals</button><button>Best sellers</button></div>
<div class="section" style="padding-top:0"><div class="products">
<div class="product" onclick="show('detail')"><div class="pic">CLOUD</div><h3>Cloud Runner</h3><p>₹2,499</p></div>
<div class="product"><div class="pic">AURA</div><h3>Aura Tote</h3><p>₹1,899</p></div>
<div class="product"><div class="pic">PULSE</div><h3>Pulse Headset</h3><p>₹4,299</p></div>
<div class="product"><div class="pic">DAILY</div><h3>Daily Set</h3><p>₹1,299</p></div>
</div></div>
</section>

<section id="detail" class="screen">
<div class="top">‹ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;♡</div>
<div class="detail-image">CLOUD<br>RUNNER</div>
<div class="detail-info"><h1>Cloud Runner</h1><h2 style="margin-top:10px">₹2,499</h2><p class="muted">4.8 ★ · 128 reviews</p><p class="muted" style="margin-top:22px;line-height:1.6">Lightweight everyday sneakers with a soft knit upper and responsive comfort sole.</p><h2 style="margin-top:28px">Size</h2>
<div class="sizes"><button class="size">7</button><button class="size selected">8</button><button class="size">9</button><button class="size">10</button></div></div>
<button class="pill full" onclick="addToCart()">ADD TO BAG · ₹2,499</button>
</section>

<section id="cart" class="screen">
<div class="top"><div class="logo">Your bag</div><p class="muted">2 items</p></div>
<div class="cart-item"><div class="thumb"></div><div><b>Cloud Runner</b><p class="muted">Size 8 · Qty 1</p><b>₹2,499</b></div></div>
<div class="cart-item"><div class="thumb" style="background:#dce5e0"></div><div><b>Aura Tote</b><p class="muted">Sand · Qty 1</p><b>₹1,899</b></div></div>
<div class="summary"><div class="row"><span>Subtotal</span><b>₹4,398</b></div><div class="row"><span>Delivery</span><b style="color:#2e8b67">FREE</b></div><div class="row total"><span>Total</span><b>₹4,398</b></div></div>
<button class="pill full" onclick="show('checkout')">CHECKOUT</button>
</section>

<section id="checkout" class="screen">
<div class="top"><div class="logo">Checkout</div><p class="muted">Almost there.</p></div>
<div class="section"><h2>Delivery address</h2></div>
<div class="form-card"><b>Home</b><p class="muted" style="margin-top:8px">12 Green Park Road, Chennai</p></div>
<div class="section"><h2>Payment</h2></div>
<div class="form-card">•••• 4242 <span style="float:right"><b>VISA</b></span></div>
<div class="summary"><b>Order summary</b><div class="row"><span>2 items</span><b>₹4,398</b></div><div class="row"><span>Delivery</span><b>FREE</b></div></div>
<button class="pill full" onclick="show('success')">PLACE ORDER · ₹4,398</button>
</section>

<section id="success" class="screen">
<div class="success"><div class="check">✓</div><h1>Order confirmed!</h1><p class="muted" style="margin-top:16px">Your NOVA order is on its way.</p>
<div class="form-card" style="text-align:left;margin-top:45px"><small class="muted">ORDER #NV-20481</small><h2 style="margin-top:14px">Arrives by Friday</h2><b style="color:#ff5a4f">Track your order →</b></div>
<button class="pill full" onclick="show('home')" style="margin-top:25px">CONTINUE SHOPPING</button></div>
</section>

<section id="profile" class="screen">
<div class="top"><div class="logo">Profile</div><p class="muted">Make it yours.</p></div>
<div class="hero" style="height:112px;margin-top:28px"><strong style="font-size:20px">Hari</strong><span class="muted">Member since 2026</span></div>
<div class="section">
<div class="form-card"><b>Orders</b><p class="muted">12 purchases</p></div>
<div class="form-card"><b>Saved</b><p class="muted">8 items</p></div>
<div class="form-card"><b>Addresses</b><p class="muted">2 saved</p></div>
<div class="form-card"><b>Settings</b><p class="muted">Preferences</p></div>
</div>
</section>

<div class="nav">
<button onclick="show('home')" data-page="home" class="active">⌂<br>Home</button>
<button onclick="show('explore')" data-page="explore">⌕<br>Explore</button>
<button onclick="show('cart')" data-page="cart">▢<br>Bag</button>
<button onclick="show('profile')" data-page="profile">○<br>Profile</button>
</div>
<div id="toast" class="toast">Added to your bag ✓</div>
</div>

<script>
function show(id){
 document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));
 window.scrollTo(0,0);
}
function addToCart(){
 const t=document.getElementById('toast');t.style.display='block';
 setTimeout(()=>{t.style.display='none';show('cart')},700);
}
</script>
</body>
</html>
